# App settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Security (optional — leave unset for local dev)
# DEMO_PASSWORD=yourpassword
# CORS_ALLOWED_ORIGINS=["https://yoursite.com"]

# LLM (HCAS reasoning steps)
# ANTHROPIC_API_KEY=sk-ant-...

# Census ACS (median household income / home value / median age on the
# step-1 county profile). Free key: https://api.census.gov/data/key_signup.html
# Without it those three fields are listed as unavailable and everything else
# still works.
# CENSUS_API_KEY=...

# Knowledgebase (Prof. Wang's GraphRAG runtime) — see docs/KNOWLEDGEBASE.md.
# Off unless you are running the runtime yourself.
# KG_ENABLED=false
# KG_BASE_URL=http://127.0.0.1:8765

# Everything in this file is exported into the process environment, so the
# operational knobs read with os.environ work here too (HCAS_DB,
# HCAS_LAYER_BUDGET_S, OSM_TIMEOUT_S, ...). Unknown names are ignored.
